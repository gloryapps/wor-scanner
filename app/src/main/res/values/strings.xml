    <string name="home_stopped_because">The scan stopped: %1$s. All %2$s are kept and can be sent.</string>
    <string name="home_link_title">Link this scanner to your account</string>
    <string name="home_link_once">· once</string>
    <string name="home_link_step_1">On the site, open Import a scan</string>
    <string name="home_link_step_2">Press Link</string>
    <string name="home_link_step_3">Type the code here</string>
    <string name="home_link_hint">K7Q4-MPX2</string>
    <string name="home_link_lasts">The code works for 10 minutes.</string>
    <string name="home_send_hint">It waits in Import a scan on the site.</string>
    <string name="home_link_send">Link and send</string>
    <string name="home_link_send_hint">You only link once. After that, Send is one press.</string>
    <string name="home_link_again">Link again</string>
    <string name="home_save_instead">Save the file instead</string>
    <string name="home_share_instead">Share the file instead</string>
    <string name="home_try_again">Try again</string>
    <string name="home_refused_code">The site knows no such code</string>
    <string name="home_refused_code_said">Codes last ten minutes and link once: press Link on the site for a new one.</string>
    <string name="home_unreachable">The site could not be reached</string>
    <string name="home_unreachable_said">Check the connection, then try again. The scan is still here.</string>
    <string name="home_unlinked">The site no longer knows this scanner</string>
    <string name="home_unlinked_said">It was unlinked on the site, or another scanner was linked. Link it again, then send.</string>
    <string name="home_too_large">This scan is too large to send</string>
    <string name="home_too_large_said">Save the file instead, then drop it on Import a scan on the site.</string>
    <string name="home_refused">The site did not read this file as a scan</string>
    <string name="home_refused_said">Save the file instead, then drop it on Import a scan on the site.</string>
    <string name="home_sent">Sent to your account</string>
    <string name="home_sent_said">Open Import a scan on Azhor’s Master Smithy to bring it in.</string>
    <string name="home_keep">Or keep the file</string>
    <string name="home_keep_said">For when sending isn’t possible. Drop the file on Import a scan on the site.</string>
