<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">WoR Scanner</string>
    <string name="touch_service_description">Taps and scrolls through Watcher of Realms while a scan runs. Nothing is read from other apps.</string>

    <string name="kind_gear">Gear</string>
    <string name="kind_heroes">Heroes</string>
    <string name="kind_artifacts">Artifacts</string>
    <string name="kind_gear_step_1">Open Storage → Gear.</string>
    <string name="kind_gear_step_2">Filter and sort it the way you want it scanned.</string>
    <string name="kind_gear_step_3">Select the first piece.</string>
    <string name="kind_gear_note">The scan taps through the grid, scrolls it itself and stops at its end.</string>
    <string name="kind_heroes_step_1">Open Hero, as cards or as squares.</string>
    <string name="kind_heroes_step_2">Sort by Rarity ↓.</string>
    <string name="kind_heroes_step_3">Select the first hero.</string>
    <string name="kind_heroes_note">Every legendary and epic is read: Attributes, Skills and Awaken. The scan stops at the first hero below epic, so keep those out of your favourites.</string>
    <string name="kind_artifacts_step_1">Open Storage → Artifact.</string>
    <string name="kind_artifacts_step_2">Sort it the way you want it scanned.</string>
    <string name="kind_artifacts_step_3">Select the first artifact.</string>
    <string name="kind_artifacts_note">Every artifact to the end of the grid is read. Ones never enhanced are skipped.</string>

    <string name="emulator_ldplayer">LDPlayer</string>
    <string name="emulator_ldplayer_pc">On Windows: Documents\\LDPlayer\\Pictures\\WoR Scanner</string>
    <string name="emulator_bluestacks">BlueStacks</string>
    <string name="emulator_bluestacks_pc">On Windows: ProgramData\\BlueStacks_nxt\\Engine\\UserData\\SharedFolder\\WoR Scanner</string>

