    <string name="permission_accessibility">Accessibility service</string>
    <string name="permission_accessibility_why">Taps and scrolls the game’s grid during a scan. It reads nothing from any app.</string>
    <string name="permission_overlay">Draw over other apps</string>
    <string name="permission_overlay_why">Shows the capsule over the game that starts, shows and stops a scan.</string>
    <string name="permission_notifications">Notifications</string>
    <string name="permission_notifications_why">Shows a scan’s progress, and a Stop you can reach from anywhere.</string>
    <string name="permission_turn_on">Turn on</string>
    <string name="permission_on">On</string>
    <string name="permission_why">Why it is asked</string>

    <string name="firstrun_title">Read your gear, heroes and artifacts straight off the game, into Azhor’s Master Smithy.</string>
    <string name="firstrun_lead">The scanner taps through the game for you. Here’s how it works:</string>
    <string name="firstrun_move_pick">Pick what to scan</string>
    <string name="firstrun_move_pick_said">Gear, Heroes or Artifacts, on the capsule over the game.</string>
    <string name="firstrun_move_pick_shot">capsule menu, kind chosen</string>
    <string name="firstrun_move_open">Open it in the game</string>
    <string name="firstrun_move_open_said">Sort it, then select the first tile. The app shows how.</string>
    <string name="firstrun_move_open_shot">game: Storage → Gear, first piece selected</string>
    <string name="firstrun_move_scan">Press Scan</string>
    <string name="firstrun_move_scan_said">It taps and scrolls by itself. Touch the screen to stop.</string>
    <string name="firstrun_move_scan_shot">capsule counting 412/2,500</string>
    <string name="firstrun_move_send">Send it to the site</string>
    <string name="firstrun_move_send_said">One press puts it in Import a scan on the site.</string>
    <string name="firstrun_move_send_shot">site: Import a scan</string>
    <string name="firstrun_next">Next: permissions</string>
    <string name="firstrun_grants_title">Three permissions, then you’re ready</string>
    <string name="firstrun_grants_lead">Android asks for each one on its own screen. Turn it on there, then come back here.</string>
    <string name="firstrun_capture">Android also asks to capture the screen %1$s. The app can’t skip that. Frames are read on the device and never sent.</string>
    <string name="firstrun_capture_each">each time a scan starts</string>
