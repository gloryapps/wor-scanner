    <string name="home_step_start">Press Start</string>
    <string name="home_step_start_said">Android asks to capture the screen. Allow it.</string>
    <string name="home_step_capsule">Tap the capsule, pick the kind</string>
    <string name="home_step_capsule_said">Then open that screen in the game, as below.</string>
    <string name="home_step_scan">Press Scan</string>
    <string name="home_step_scan_said">Touch the screen to stop. What was read is kept.</string>
