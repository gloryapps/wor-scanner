    <string name="firstrun_title">Read your gear, heroes and artifacts straight off the game, into Azhor’s Master Smithy.</string>
    <string name="firstrun_lead">The scanner taps through the game for you. Here’s how it works:</string>
    <string name="firstrun_move_open">Open what to scan</string>
    <string name="firstrun_move_open_said">Gear, Heroes or Artifacts, sorted, the first tile selected.</string>
    <string name="firstrun_move_scan">Pick it, press Scan</string>
    <string name="firstrun_move_scan_said">On the capsule’s menu. A touch on the screen stops it.</string>
    <string name="firstrun_move_send">Send it to the site</string>
    <string name="firstrun_move_send_said">One press as it ends. The first time, with the site’s code.</string>
    <string name="firstrun_move_import">Import it on the site</string>
    <string name="firstrun_move_import_said">It waits in Import a scan there. Press Import.</string>
    <string name="firstrun_next">Next: permissions</string>
    <string name="firstrun_grants_title">Three permissions, then you’re ready</string>
    <string name="firstrun_grants_lead">Android asks for each one on its own screen. Turn it on there, then come back here.</string>
    <string name="firstrun_capture">Android also asks to capture the screen %1$s. The app can’t skip that. Frames are read on the device and never sent.</string>
    <string name="firstrun_capture_each">each time a scan starts</string>
